{
  "name": "mettc",
  "version": "1.0.0",
  "description": "Mapping Encryption Text To Confused",
  "author": "METTC Team",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.mettc.desktop",
    "productName": "METTC",
    "compression": "maximum",
    "asar": true,
    "win": {
      "target": "portable",
      "icon": "build/icon.ico"
    },
    "files": [
      "main.js",
      "preload.js",
      "config.js",
      "src/**/*"
    ],
    "directories": {
      "output": "dist"
    }
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  }
}